# Paste into Streamlit Cloud > App settings > Secrets
GOOGLE_API_KEY = "..."
GROQ_API_KEY = "..."
OPENROUTER_API_KEY = "..."

# No Ollama in the cloud -> run Completeness + Style critics on Groq
COMPLETENESS_PROVIDER = "groq"
COMPLETENESS_MODEL = "openai/gpt-oss-20b"
STYLE_PROVIDER = "groq"
STYLE_MODEL = "qwen/qwen3.8-27b"
# Free OpenRouter models are rate-limited constantly -> use Groq primary, OpenRouter as fallback
SAFETY_PROVIDER = "groq"
SAFETY_MODEL = "openai/gpt-oss-20b"
SAFETY_FALLBACK_PROVIDER = "openrouter"
SAFETY_FALLBACK_MODEL = "google/gemma-4-31b-it:free"
