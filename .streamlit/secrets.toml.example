# Paste into Streamlit Cloud > App settings > Secrets
GOOGLE_API_KEY = "..."
GROQ_API_KEY = "..."
OPENROUTER_API_KEY = "..."

# No Ollama in the cloud -> run Completeness + Style critics on Groq
COMPLETENESS_PROVIDER = "groq"
COMPLETENESS_MODEL = "openai/gpt-oss-20b"
STYLE_PROVIDER = "groq"
STYLE_MODEL = "qwen/qwen3.8-27b"
SAFETY_FALLBACK_MODEL = "openai/gpt-oss-20b"
SAFETY_FALLBACK_PROVIDER = "groq"
